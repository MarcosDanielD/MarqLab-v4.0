# Python Virtual Environment
.venv/
venv/
ENV/
env/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# SQLite Database (Mantém localmente, ou comente se desejar versionar banco pré-populado)
*.db
*.sqlite
*.sqlite3

# Playwright cache
.playwright/

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.idea/
.vscode/
*.swp
*.swo

